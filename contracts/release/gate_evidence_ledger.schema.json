{
  "$defs": {
    "GateArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "contentPersisted": {
          "default": false,
          "title": "Contentpersisted",
          "type": "boolean"
        },
        "kind": {
          "default": "unknown",
          "enum": [
            "json",
            "md",
            "log",
            "text",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reasonCodes": {
          "items": {
            "type": "string"
          },
          "title": "Reasoncodes",
          "type": "array"
        },
        "scanStatus": {
          "default": "pass",
          "enum": [
            "pass",
            "fail",
            "skipped"
          ],
          "title": "Scanstatus",
          "type": "string"
        },
        "schemaRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schemaref"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "sizeBytes": {
          "minimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "sizeBytes"
      ],
      "title": "GateArtifactRef",
      "type": "object"
    },
    "GateCommandExecution": {
      "additionalProperties": false,
      "properties": {
        "blockingReasons": {
          "items": {
            "type": "string"
          },
          "title": "Blockingreasons",
          "type": "array"
        },
        "commandId": {
          "title": "Commandid",
          "type": "string"
        },
        "durationMs": {
          "default": 0,
          "title": "Durationms",
          "type": "integer"
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exitcode"
        },
        "redactedStderrTail": {
          "default": "",
          "title": "Redactedstderrtail",
          "type": "string"
        },
        "redactedStdoutTail": {
          "default": "",
          "title": "Redactedstdouttail",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked",
            "timeout"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "commandId",
        "status"
      ],
      "title": "GateCommandExecution",
      "type": "object"
    },
    "GateRunResult": {
      "additionalProperties": false,
      "properties": {
        "artifactRefs": {
          "items": {
            "$ref": "#/$defs/GateArtifactRef"
          },
          "title": "Artifactrefs",
          "type": "array"
        },
        "blockingReasons": {
          "items": {
            "type": "string"
          },
          "title": "Blockingreasons",
          "type": "array"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/GateCommandExecution"
          },
          "title": "Commands",
          "type": "array"
        },
        "durationMs": {
          "minimum": 0,
          "title": "Durationms",
          "type": "integer"
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exitcode"
        },
        "finishedAtUtc": {
          "format": "date-time",
          "title": "Finishedatutc",
          "type": "string"
        },
        "gateId": {
          "title": "Gateid",
          "type": "string"
        },
        "missingArtifactRequirements": {
          "items": {
            "type": "string"
          },
          "title": "Missingartifactrequirements",
          "type": "array"
        },
        "rawMarkerScanStatus": {
          "default": "pass",
          "enum": [
            "pass",
            "fail",
            "skipped"
          ],
          "title": "Rawmarkerscanstatus",
          "type": "string"
        },
        "schemaVersion": {
          "const": "release.gate-run-result/v1",
          "default": "release.gate-run-result/v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "secretScanStatus": {
          "default": "pass",
          "enum": [
            "pass",
            "fail",
            "skipped"
          ],
          "title": "Secretscanstatus",
          "type": "string"
        },
        "startedAtUtc": {
          "format": "date-time",
          "title": "Startedatutc",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked",
            "conditional",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "worktreeMutated": {
          "default": false,
          "title": "Worktreemutated",
          "type": "boolean"
        }
      },
      "required": [
        "gateId",
        "status",
        "startedAtUtc",
        "finishedAtUtc",
        "durationMs"
      ],
      "title": "GateRunResult",
      "type": "object"
    },
    "ReleaseGateTarget": {
      "additionalProperties": false,
      "properties": {
        "allowExpectedConditionals": {
          "default": false,
          "title": "Allowexpectedconditionals",
          "type": "boolean"
        },
        "mode": {
          "default": "rc-full",
          "enum": [
            "rc-focused",
            "rc-full"
          ],
          "title": "Mode",
          "type": "string"
        },
        "outputRoot": {
          "title": "Outputroot",
          "type": "string"
        },
        "platform": {
          "default": "auto",
          "enum": [
            "auto",
            "windows",
            "macos",
            "linux",
            "unknown",
            "github_actions"
          ],
          "title": "Platform",
          "type": "string"
        },
        "profile": {
          "default": "enterprise",
          "title": "Profile",
          "type": "string"
        },
        "targetId": {
          "enum": [
            "mainline-rc",
            "design-partner-rc",
            "pilot-readiness"
          ],
          "title": "Targetid",
          "type": "string"
        }
      },
      "required": [
        "targetId",
        "outputRoot"
      ],
      "title": "ReleaseGateTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifactRoot": {
      "title": "Artifactroot",
      "type": "string"
    },
    "blockingReasons": {
      "items": {
        "type": "string"
      },
      "title": "Blockingreasons",
      "type": "array"
    },
    "branch": {
      "title": "Branch",
      "type": "string"
    },
    "gateResults": {
      "items": {
        "$ref": "#/$defs/GateRunResult"
      },
      "title": "Gateresults",
      "type": "array"
    },
    "generatedAtUtc": {
      "format": "date-time",
      "title": "Generatedatutc",
      "type": "string"
    },
    "ledgerSha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ledgersha256"
    },
    "repoHeadSha": {
      "title": "Repoheadsha",
      "type": "string"
    },
    "requiredGateIds": {
      "items": {
        "type": "string"
      },
      "title": "Requiredgateids",
      "type": "array"
    },
    "schemaVersion": {
      "const": "release.gate-evidence-ledger/v1",
      "default": "release.gate-evidence-ledger/v1",
      "title": "Schemaversion",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "conditional",
        "blocked",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ReleaseGateTarget"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "repoHeadSha",
    "branch",
    "target",
    "status",
    "artifactRoot"
  ],
  "title": "GateEvidenceLedger",
  "type": "object"
}