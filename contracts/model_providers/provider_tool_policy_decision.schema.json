{
  "$defs": {
    "ProviderRequestedToolType": {
      "enum": [
        "custom_function",
        "builtin_web_search",
        "builtin_file_search",
        "builtin_computer_use",
        "mcp",
        "server_tool",
        "unknown"
      ],
      "title": "ProviderRequestedToolType",
      "type": "string"
    },
    "ProviderToolPolicyStatus": {
      "enum": [
        "allow_proposal",
        "deny",
        "requires_approval"
      ],
      "title": "ProviderToolPolicyStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_required": {
      "default": false,
      "title": "Approval Required",
      "type": "boolean"
    },
    "execution_allowed": {
      "default": false,
      "title": "Execution Allowed",
      "type": "boolean"
    },
    "proposal_allowed": {
      "default": false,
      "title": "Proposal Allowed",
      "type": "boolean"
    },
    "reason_code": {
      "title": "Reason Code",
      "type": "string"
    },
    "requested_tool_type": {
      "$ref": "#/$defs/ProviderRequestedToolType"
    },
    "status": {
      "$ref": "#/$defs/ProviderToolPolicyStatus"
    },
    "tool_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Name"
    }
  },
  "required": [
    "status",
    "requested_tool_type",
    "reason_code"
  ],
  "title": "ProviderToolPolicyDecision",
  "type": "object"
}
