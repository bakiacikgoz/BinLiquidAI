{
  "$defs": {
    "ArtifactMutationType": {
      "enum": [
        "create",
        "replace_content",
        "json_patch",
        "text_edit",
        "cell_patch",
        "slide_patch",
        "restore",
        "duplicate",
        "import_evidence"
      ],
      "title": "ArtifactMutationType",
      "type": "string"
    },
    "JsonValue": {}
  },
  "$id": "https://schemas.imperaos.local/artifacts/artifact-mutation-proposal-command.v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Artifactid",
      "type": "string"
    },
    "baseRevisionNumber": {
      "minimum": 1,
      "title": "Baserevisionnumber",
      "type": "integer"
    },
    "content": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Content",
      "type": "object"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Idempotencykey",
      "type": "string"
    },
    "mutationType": {
      "$ref": "#/$defs/ArtifactMutationType"
    },
    "proposalId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposalid"
    },
    "summary": {
      "default": "",
      "maxLength": 500,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "artifactId",
    "baseRevisionNumber",
    "mutationType",
    "content",
    "idempotencyKey"
  ],
  "title": "ProposeArtifactMutationCommand",
  "type": "object",
  "x-imperaos-contract": "artifact-mutation-proposal-command.v1"
}