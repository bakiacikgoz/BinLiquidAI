{
  "additionalProperties": false,
  "properties": {
    "artifactPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifactpath"
    },
    "expiredResultCount": {
      "default": 0,
      "minimum": 0,
      "title": "Expiredresultcount",
      "type": "integer"
    },
    "generatedAtUtc": {
      "format": "date-time",
      "title": "Generatedatutc",
      "type": "string"
    },
    "hardNegativeLeakCount": {
      "minimum": 0,
      "title": "Hardnegativeleakcount",
      "type": "integer"
    },
    "queryCount": {
      "minimum": 0,
      "title": "Querycount",
      "type": "integer"
    },
    "rawContentIncluded": {
      "const": false,
      "default": false,
      "title": "Rawcontentincluded",
      "type": "boolean"
    },
    "rawLeakCount": {
      "default": 0,
      "minimum": 0,
      "title": "Rawleakcount",
      "type": "integer"
    },
    "reasonCodes": {
      "items": {
        "type": "string"
      },
      "title": "Reasoncodes",
      "type": "array"
    },
    "schemaVersion": {
      "const": "memory-retrieval-quality-report/v1",
      "default": "memory-retrieval-quality-report/v1",
      "title": "Schemaversion",
      "type": "string"
    },
    "scopeViolationCount": {
      "default": 0,
      "minimum": 0,
      "title": "Scopeviolationcount",
      "type": "integer"
    },
    "staleResultCount": {
      "default": 0,
      "minimum": 0,
      "title": "Staleresultcount",
      "type": "integer"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    },
    "topKRecall": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Topkrecall",
      "type": "number"
    }
  },
  "required": [
    "status",
    "queryCount",
    "topKRecall",
    "hardNegativeLeakCount"
  ],
  "title": "MemoryRetrievalQualityReport",
  "type": "object"
}
