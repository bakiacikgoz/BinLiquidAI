  },
  "additionalProperties": false,
  "properties": {
    "contextPack": {
      "$ref": "#/$defs/MemoryContextPack"
    },
    "decision": {
      "$ref": "#/$defs/AgentMemoryRuntimePolicyDecision"
    },
    "rawContentIncluded": {
      "const": false,
      "default": false,
      "title": "Rawcontentincluded",
      "type": "boolean"
    },
    "resolvedPrincipal": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResolvedMemoryPrincipal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "decision",
    "contextPack"
  ],
  "title": "AgentMemoryRuntimePolicyReadResult",
  "type": "object"
}
