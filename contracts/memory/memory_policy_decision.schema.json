{
  "$defs": {
    "MemoryPolicyAction": {
      "enum": [
        "allow",
        "deny",
        "require_approval",
        "proposal_only"
      ],
      "title": "MemoryPolicyAction",
      "type": "string"
    },
    "RetentionClass": {
      "enum": [
        "ephemeral",
        "standard",
        "regulated"
      ],
      "title": "RetentionClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
