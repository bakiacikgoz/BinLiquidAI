      "minLength": 1,
      "title": "Displayname",
      "type": "string"
    },
    "externalSubjectRefHash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Externalsubjectrefhash"
    },
    "principalId": {
      "title": "Principalid",
      "type": "string"
    },
