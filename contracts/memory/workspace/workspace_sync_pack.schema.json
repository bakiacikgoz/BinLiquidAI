{
  "$defs": {
    "WorkspaceMemoryRecord": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "restricted",
            "secret_like"
          ],
          "title": "Classification",
          "type": "string"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "contentHash": {
          "title": "Contenthash",
          "type": "string"
        },
        "createdAtUtc": {
          "format": "date-time",
          "title": "Createdatutc",
          "type": "string"
        },
        "embeddingRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embeddingref"
        },
        "expiresAtUtc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiresatutc"
        },
        "memoryId": {
          "title": "Memoryid",
          "type": "string"
        },
        "memoryTarget": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memorytarget"
        },
        "ownerPrincipalId": {
          "title": "Ownerprincipalid",
          "type": "string"
        },
        "policyTags": {
          "items": {
            "type": "string"
          },
          "title": "Policytags",
          "type": "array"
        },
        "redactedPreview": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redactedpreview"
        },
        "salience": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Salience",
          "type": "number"
        },
        "schemaVersion": {
          "const": "workspace-memory-record/v1",
          "default": "workspace-memory-record/v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "scopeId": {
          "title": "Scopeid",
          "type": "string"
        },
        "scopeType": {
          "enum": [
            "personal",
            "agent",
            "team",
            "project",
            "case",
            "organization",
            "global_readonly"
          ],
          "title": "Scopetype",
          "type": "string"
        },
        "sourceAgentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourceagentid"
        },
        "sourceRunId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcerunid"
        },
        "sourceUserId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourceuserid"
        },
        "stateVersion": {
          "default": 1,
          "minimum": 1,
          "title": "Stateversion",
          "type": "integer"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "tombstonedAtUtc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tombstonedatutc"
        },
        "ttlDays": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttldays"
        },
        "updatedAtUtc": {
          "format": "date-time",
          "title": "Updatedatutc",
          "type": "string"
        },
        "workspaceId": {
          "title": "Workspaceid",
          "type": "string"
        }
      },
      "required": [
        "memoryId",
        "workspaceId",
        "scopeType",
        "scopeId",
        "ownerPrincipalId",
        "contentHash",
        "summary"
      ],
      "title": "WorkspaceMemoryRecord",
      "type": "object"
    },
    "WorkspaceMemorySyncPackManifest": {
      "additionalProperties": false,
      "properties": {
        "conflictCount": {
          "default": 0,
          "minimum": 0,
          "title": "Conflictcount",
          "type": "integer"
        },
        "cursorFrom": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursorfrom"
        },
        "cursorTo": {
          "title": "Cursorto",
          "type": "string"
        },
        "evidenceMode": {
          "const": "hash_only",
          "default": "hash_only",
          "title": "Evidencemode",
          "type": "string"
        },
        "generatedAtUtc": {
          "format": "date-time",
          "title": "Generatedatutc",
          "type": "string"
        },
        "itemHashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Itemhashes",
          "type": "object"
        },
        "manifestHash": {
          "title": "Manifesthash",
          "type": "string"
        },
        "packId": {
          "title": "Packid",
          "type": "string"
        },
        "rawContentIncluded": {
          "const": false,
          "default": false,
          "title": "Rawcontentincluded",
          "type": "boolean"
        },
        "recordCount": {
          "minimum": 0,
          "title": "Recordcount",
          "type": "integer"
        },
        "schemaVersion": {
          "const": "workspace-memory-sync-pack/v2",
          "default": "workspace-memory-sync-pack/v2",
          "title": "Schemaversion",
          "type": "string"
        },
        "sourceClientId": {
          "title": "Sourceclientid",
          "type": "string"
        },
        "tombstoneCount": {
          "default": 0,
          "minimum": 0,
          "title": "Tombstonecount",
          "type": "integer"
        },
        "workspaceId": {
          "title": "Workspaceid",
          "type": "string"
        }
      },
      "required": [
        "packId",
        "workspaceId",
        "sourceClientId",
        "cursorTo",
        "recordCount",
        "manifestHash"
      ],
      "title": "WorkspaceMemorySyncPackManifest",
      "type": "object"
    },
    "WorkspaceMemoryTombstoneResult": {
      "additionalProperties": false,
      "properties": {
        "evidenceRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidenceref"
        },
        "memoryId": {
          "title": "Memoryid",
          "type": "string"
        },
        "rawContentIncluded": {
          "const": false,
          "default": false,
          "title": "Rawcontentincluded",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "tombstoned",
            "denied",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "memoryId"
      ],
      "title": "WorkspaceMemoryTombstoneResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "$ref": "#/$defs/WorkspaceMemorySyncPackManifest"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/WorkspaceMemoryRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "tombstones": {
      "items": {
        "$ref": "#/$defs/WorkspaceMemoryTombstoneResult"
      },
      "title": "Tombstones",
      "type": "array"
    }
  },
  "required": [
    "manifest"
  ],
  "title": "WorkspaceMemorySyncPack",
  "type": "object"
}
