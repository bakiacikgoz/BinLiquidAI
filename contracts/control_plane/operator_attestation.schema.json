    "signedAtUtc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signedatutc"
    },
    "version": {
      "const": "control-plane.operator-attestation/v1",
      "default": "control-plane.operator-attestation/v1",
      "title": "Version",
      "type": "string"
