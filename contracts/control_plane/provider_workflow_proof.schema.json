      "title": "Status",
      "type": "string"
    },
    "workflowId": {
      "title": "Workflowid",
      "type": "string"
    },
    "workflowKind": {
      "const": "read_only_ops_triage",
      "title": "Workflowkind",
      "type": "string"
    }
  },
  "required": [
    "status",
    "workflowId",
    "workflowKind",
    "agentId"
