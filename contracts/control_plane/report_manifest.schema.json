          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reportId": {
          "title": "Reportid",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "conditional",
            "blocked",
            "missing"
