          "title": "Alertid",
          "type": "string"
        },
        "firstSeenAt": {
          "format": "date-time",
          "title": "Firstseenat",
          "type": "string"
        },
        "lastSeenAt": {
          "format": "date-time",
          "title": "Lastseenat",
          "type": "string"
        },
        "reasonCode": {
          "title": "Reasoncode",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "enum": [
            "snapshot",
            "evidence",
            "policy",
            "approval",
            "runtime",
            "ci"
