          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "reportId",
        "kind",
        "title",
        "status",
        "path",
        "generatedAtUtc",
        "summary"
      ],
      "title": "ReportManifestItem",
      "type": "object"
    }
