    },
    "reports": {
      "items": {
        "$ref": "#/$defs/ReportManifestItem"
      },
      "title": "Reports",
      "type": "array"
    },
    "status": {
      "enum": [
        "pass",
        "conditional",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "version": {
      "const": "control-plane.report-manifest/v1",
      "default": "control-plane.report-manifest/v1",
      "title": "Version",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
