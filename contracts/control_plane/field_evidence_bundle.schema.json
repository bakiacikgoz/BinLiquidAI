{
  "$defs": {
    "FieldEvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "title": "Artifactid",
          "type": "string"
        },
        "generatedAtUtc": {
          "format": "date-time",
          "title": "Generatedatutc",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "rawPersistence": {
          "default": false,
          "title": "Rawpersistence",
          "type": "boolean"
        },
        "redactionStatus": {
          "default": "redacted",
          "enum": [
            "redacted",
            "not_applicable"
          ],
          "title": "Redactionstatus",
          "type": "string"
        },
        "relativePath": {
          "title": "Relativepath",
          "type": "string"
        },
        "requiredForStrictRc": {
          "default": false,
          "title": "Requiredforstrictrc",
          "type": "boolean"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "signatureStatus": {
          "default": "missing",
          "enum": [
            "valid",
            "pending",
            "missing",
            "invalid"
          ],
          "title": "Signaturestatus",
          "type": "string"
        },
        "sizeBytes": {
          "minimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        }
      },
      "required": [
        "artifactId",
        "kind",
        "relativePath",
        "sha256",
        "sizeBytes",
        "generatedAtUtc",
        "producer"
      ],
      "title": "FieldEvidenceItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blockingReasons": {
      "items": {
        "type": "string"
      },
      "title": "Blockingreasons",
      "type": "array"
    },
    "bundleSha256": {
      "default": "sha256:pending",
      "title": "Bundlesha256",
      "type": "string"
    },
    "claimBoundaries": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Claimboundaries",
      "type": "object"
    },
    "generatedAtUtc": {
      "format": "date-time",
      "title": "Generatedatutc",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/FieldEvidenceItem"
      },
      "title": "Items",
      "type": "array"
    },
    "mode": {
      "enum": [
        "rehearsal",
        "target_environment"
      ],
      "title": "Mode",
      "type": "string"
    },
    "piiPersistence": {
      "default": false,
      "title": "Piipersistence",
      "type": "boolean"
    },
    "rawPersistence": {
      "default": false,
      "title": "Rawpersistence",
      "type": "boolean"
    },
    "schemaVersion": {
      "const": "control-plane.field-evidence-bundle/v1",
      "default": "control-plane.field-evidence-bundle/v1",
      "title": "Schemaversion",
      "type": "string"
    },
    "secretPersistence": {
      "default": false,
      "title": "Secretpersistence",
      "type": "boolean"
    },
    "sessionId": {
      "title": "Sessionid",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "sessionId",
    "mode"
  ],
  "title": "FieldEvidenceBundle",
  "type": "object"
}