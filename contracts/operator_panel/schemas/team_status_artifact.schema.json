        "input_payload": {
          "additionalProperties": true,
          "title": "Input Payload",
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus",
          "default": "pending"
        },
        "attempt_count": {
          "default": 0,
          "minimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "approval_state": {
          "default": "none",
