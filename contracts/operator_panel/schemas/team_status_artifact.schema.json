    "audit_envelope_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audit Envelope Path"
    },
    "job_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Dir"
    },
    "resume_outcomes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Resume Outcomes",
      "type": "array"
    },
    "continuation": {
      "additionalProperties": true,
      "title": "Continuation",
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "job"
  ],
  "title": "TeamStatusArtifactContract",
  "type": "object"
}