          "title": "Job Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "team_id": {
          "title": "Team Id",
          "type": "string"
        },
        "request": {
          "title": "Request",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/JobStatus",
          "default": "pending"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "final_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Output"
        },
        "metrics": {
          "additionalProperties": true,
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "job_id",
        "case_id",
        "team_id",
        "request"
      ],
      "title": "JobRun",
      "type": "object"
    },
    "JobStatus": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "blocked"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "TaskRun": {
