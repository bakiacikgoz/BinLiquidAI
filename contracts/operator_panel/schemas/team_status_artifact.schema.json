      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "blocked",
        "escalated"
      ],
      "title": "TaskStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.0",
