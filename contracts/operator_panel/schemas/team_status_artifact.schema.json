          "type": "string"
        },
        "result_payload": {
          "additionalProperties": true,
          "title": "Result Payload",
          "type": "object"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
