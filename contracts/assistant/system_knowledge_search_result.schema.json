        "chunkId": {
          "title": "Chunkid",
          "type": "string"
        },
        "commands": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "heading": {
          "default": "",
          "title": "Heading",
          "type": "string"
        },
        "matchedTerms": {
          "default": [],
