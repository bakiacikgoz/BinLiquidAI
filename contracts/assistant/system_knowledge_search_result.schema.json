        "$ref": "#/$defs/KnowledgeHit"
      },
      "title": "Hits",
      "type": "array"
    },
    "intent": {
      "$ref": "#/$defs/KnowledgeIntent"
    },
    "normalizedQuery": {
      "title": "Normalizedquery",
      "type": "string"
    },
    "queryHash": {
      "title": "Queryhash",
      "type": "string"
