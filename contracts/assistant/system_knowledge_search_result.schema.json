      "type": "object"
    },
    "KnowledgeIntent": {
      "enum": [
        "platform_usage",
        "agent_task",
        "approval",
        "run_evidence",
        "provider",
        "memory",
        "computer_use",
        "deployment",
        "unknown"
      ],
      "title": "KnowledgeIntent",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blockingReasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Blockingreasons",
      "type": "array"
    },
    "generatedAtUtc": {
      "title": "Generatedatutc",
      "type": "string"
    },
    "hits": {
      "default": [],
