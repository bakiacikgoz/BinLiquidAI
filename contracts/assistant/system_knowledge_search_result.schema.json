            "type": "string"
          },
          "title": "Matchedterms",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "snippet": {
          "maxLength": 1200,
          "title": "Snippet",
          "type": "string"
