{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "ImperaOS",
        "width": 1480,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 23
        },
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        },
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ]
  }
}
