{
  "name": "operator-panel",
  "private": true,
  "version": "0.5.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "build": "tsc -b && vite build",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:interaction": "vitest run interaction --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test e2e/accessibility.spec.ts --pass-with-no-tests",
    "test:responsive": "playwright test e2e/responsive.spec.ts --pass-with-no-tests",
    "audit:ui-controls": "node --experimental-strip-types scripts/audit-ui-controls.ts",
    "assert:no-primary-raw-json": "node --experimental-strip-types scripts/assert-no-primary-raw-json.ts",
    "i18n:coverage": "node --experimental-strip-types scripts/assert-i18n-coverage.ts",
    "pilot:assert": "node --experimental-strip-types scripts/assert-pilot-readiness.ts",
    "qa:summary": "node --experimental-strip-types scripts/write-frontend-qa-summary.ts",
    "qa:frontend:static": "pnpm audit:ui-controls && pnpm i18n:coverage && pnpm test && pnpm lint && pnpm build && pnpm qa:summary -- --static-passed",
    "qa:frontend": "pnpm audit:ui-controls && pnpm i18n:coverage && pnpm test && pnpm lint && pnpm build && pnpm test:e2e && pnpm qa:summary -- --static-passed --e2e-required",
    "qa:productization": "pnpm i18n:coverage && pnpm test && pnpm lint && pnpm build && pnpm test:e2e && tsx scripts/assert-productized-pages.ts",
    "tauri:smoke": "node --experimental-strip-types scripts/tauri-launched-smoke.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8"
}
